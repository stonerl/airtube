{
    "manifest_version": 3,
    "default_locale": "en",

    "name": "__MSG_extension_name__",
    "description": "__MSG_extension_description__",
    "version": "1.0",

    "icons": {
        "48": "images/icon.png",
        "96": "images/icon.png",
        "128": "images/icon.png",
        "256": "images/icon.png",
        "512": "images/icon.png"
    },

    "content_scripts": [
        {
            "js": [ "content.js" ],
            "matches": [ "*://*.youtube.com/*" ],
            "run_at": "document_start"
        },
        {
            "js": [ "inject.js" ],
            "matches": [ "*://*.youtube.com/*" ],
            "world": "MAIN",
            "run_at": "document_start"
        }
    ],

    "web_accessible_resources": [
        {
            "resources": [ "inject.js" ],
            "matches": [ "*://*.youtube.com/*" ]
        }
    ],

    "action": {
        "default_popup": "popup.html",
        "default_icon": "images/toolbar-icon.svg"
    },

    "permissions": [ "storage" ]
}
